# 应用配置
APP_NAME=AI Kitchen Assistant
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置 (MariaDB)
DB_HOST=192.168.31.146
DB_PORT=3307
DB_USER=cook
DB_PASSWORD=Wzcx131130_
DB_NAME=cook
DATABASE_URL=
# 是否打印 SQL 语句（调试 SQL 时设为 true）
SQL_ECHO=false

# LLM 配置
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434
# 可选 Anthropic 云端供应商（AI 采集摘要）：LLM_PROVIDER=anthropic 时生效
ANTHROPIC_LLM_MODEL=claude-opus-5

# 联网搜索（AI 采集入库）：前往 https://app.tavily.com 免费注册获取 API key
TAVILY_API_KEY=

# RAG 配置
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./data/chroma
CHROMA_COLLECTION=recipes
CHROMA_SPACE=cosine
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT=60
RECALL_TOP_K=20
RERANK_TOP_K=10
INDEX_MAX_WORKERS=2

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# 安全配置
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
