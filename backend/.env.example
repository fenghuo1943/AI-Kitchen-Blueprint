# 应用配置
APP_NAME=AI Kitchen Assistant
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true

# 服务器配置（8001：8000 被 SillyTavern 的 127.0.0.1:8000 占用，遮蔽本后端）
HOST=0.0.0.0
PORT=8001

# 数据库配置 (MariaDB)
DB_HOST=192.168.31.146
DB_PORT=3307
DB_USER=cook
DB_PASSWORD=Wzcx131130_
DB_NAME=cook
DATABASE_URL=
# 是否打印 SQL 语句（调试 SQL 时设为 true）
SQL_ECHO=false

# 数据库连接重试（数据库未就绪时不崩溃，降级启动 + 后台重试）
DB_RETRY_ATTEMPTS=3        # 启动阶段重试次数
DB_RETRY_INTERVAL=3        # 启动阶段每次重试间隔（秒）
DB_BG_RETRY_INTERVAL=20    # 降级模式下后台重试间隔（秒）

# LLM 配置
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434
# 可选 Anthropic 云端供应商（AI 采集摘要）：LLM_PROVIDER=anthropic 时生效
ANTHROPIC_LLM_MODEL=claude-opus-5
# 可选 DeepSeek 云端（OpenAI 兼容协议）：LLM_PROVIDER=deepseek 时生效
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 可选 OpenRouter 聚合（含小米 MiMo 等开源模型）：LLM_PROVIDER=openrouter 时生效
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=xiaomi/mimo-7b
# 可选任意 OpenAI 兼容端点（base_url 留空回落 LLM_BASE_URL）：LLM_PROVIDER=openai_compat 时生效
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=gpt-4o-mini

# 联网搜索（AI 采集入库）：前往 https://app.tavily.com 免费注册获取 API key
TAVILY_API_KEY=
# AI 采集默认限定搜索的站点域名（Tavily include_domains），逗号分隔；留空=全网搜索
# 如：xiachufang.com,meishichina.com
AI_COLLECT_SEARCH_SITES=

# 浏览器抓取（Playwright，用于小红书等登录墙/反爬站点）
# Tavily 抓不到登录墙正文时，由本地浏览器兜底抓取（复用 profile 登录态）。
# 有 Chrome/Edge 无需 playwright install；否则需执行 playwright install chromium。
BROWSER_FETCH_ENABLED=true
BROWSER_USER_DATA_DIR=./data/browser_profile
BROWSER_HEADED=true
# chrome / msedge / chromium；留空自动探测（优先 Chrome，回落 Edge，再 chromium）
BROWSER_CHANNEL=
# 页面加载等待上限（毫秒）
BROWSER_LAUNCH_TIMEOUT=60000

# RAG 配置
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./data/chroma
CHROMA_COLLECTION=recipes
CHROMA_SPACE=cosine
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT=60
RECALL_TOP_K=20
RERANK_TOP_K=10
INDEX_MAX_WORKERS=2

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# 安全配置
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost:8006
