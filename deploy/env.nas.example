# 群晖 NAS 版 .env 增量配置
# 用法：把 backend/.env.example 复制为 backend/.env 后，用本文件覆盖以下字段（把占位符换成实际 IP）

# ---- 生产环境 ----
APP_ENV=production
APP_DEBUG=false

# ---- 数据库：指向 MariaDB 所在机器（若是群晖本体，填群晖局域网 IP）----
DB_HOST=192.168.x.x
DB_PORT=3307
DB_USER=cook
DB_PASSWORD=你的数据库密码
DB_NAME=cook

# ---- Ollama：指向跑 Ollama 的那台机器（不能再用 127.0.0.1）----
LLM_BASE_URL=http://192.168.x.x:11434
EMBEDDING_BASE_URL=http://192.168.x.x:11434

# ---- 允许跨域来源：填访问前端的地址（HTTP 8005 和 HTTPS 8006 都要加）----
ALLOWED_ORIGINS=http://192.168.x.x:8005,https://192.168.x.x:8006,http://nas.你的域名.com

# ---- 浏览器抓取：容器内不装 chromium 就关掉 ----
BROWSER_FETCH_ENABLED=false

# ---- RAG 数据目录（相对 /app，即挂载的 backend/ 目录，自动持久化到 NAS 磁盘）----
VECTOR_STORE_PATH=./data/chroma
